    <!-- ===================== Cultivos ===================== -->
    <!-- Lechuga -->
    <string name="lechuga_nombre">Lechuga</string>
    <string name="lechuga_emoji">🥬</string>
    <string name="lechuga_descripcion">Es el cultivo más fácil para empezar en hidroponía porque crece rápido y no necesita mucho cuidado.</string>
    <string name="lechuga_sistema">NFT o raíz flotante</string>
    <string name="lechuga_luz">10 a 14 horas al día</string>
    <string name="lechuga_germinacion">2 a 7 días</string>
    <string name="lechuga_cosecha">45 a 60 días</string>
    <string name="lechuga_distancia">20 cm entre plantas</string>
    <string name="lechuga_nutrientes">Nitrógeno (hojas verdes) y calcio</string>
    <string name="lechuga_plagas">Pulgones y trips. Con mucho calor se queman las puntas de las hojas.</string>
    <string name="lechuga_consejo">Puedes cosechar solo las hojas de afuera y la planta sigue creciendo.</string>

    <!-- Albahaca -->
    <string name="albahaca_nombre">Albahaca</string>
    <string name="albahaca_emoji">🌿</string>
    <string name="albahaca_descripcion">Hierba aromática que crece muy bien en agua. Se usa mucho en la cocina.</string>
    <string name="albahaca_sistema">NFT o goteo</string>
    <string name="albahaca_luz">14 a 16 horas al día</string>
    <string name="albahaca_germinacion">5 a 10 días</string>
    <string name="albahaca_cosecha">60 días (primera cosecha a las 4 semanas)</string>
    <string name="albahaca_distancia">25 cm entre plantas</string>
    <string name="albahaca_nutrientes">Nitrógeno y magnesio</string>
    <string name="albahaca_plagas">Mosca blanca, pulgones y hongos (mildiu).</string>
    <string name="albahaca_consejo">Corta las flores apenas aparezcan para que la planta siga dando hojas.</string>

    <!-- Tomate cherry -->
    <string name="tomate_nombre">Tomate cherry</string>
    <string name="tomate_emoji">🍅</string>
    <string name="tomate_descripcion">Planta más grande que da frutos. Necesita más nutrientes y más luz que las hortalizas de hoja.</string>
    <string name="tomate_sistema">Goteo con sustrato (fibra de coco o perlita)</string>
    <string name="tomate_luz">14 a 18 horas al día</string>
    <string name="tomate_germinacion">5 a 10 días</string>
    <string name="tomate_cosecha">80 a 90 días</string>
    <string name="tomate_distancia">40 cm entre plantas</string>
    <string name="tomate_nutrientes">Potasio y calcio cuando empieza a dar frutos</string>
    <string name="tomate_plagas">Mosca blanca y araña roja. La falta de calcio pudre la punta del tomate.</string>
    <string name="tomate_consejo">Amarra la planta a un tutor y mueve las flores para ayudar a la polinización.</string>

    <!-- Frutilla -->
    <string name="frutilla_nombre">Frutilla</string>
    <string name="frutilla_emoji">🍓</string>
    <string name="frutilla_descripcion">Se cultiva muy bien en torres verticales y ocupa poco espacio.</string>
    <string name="frutilla_sistema">Torre vertical o NFT</string>
    <string name="frutilla_luz">12 a 16 horas al día</string>
    <string name="frutilla_germinacion">Se planta desde estolones (hijos de otra planta)</string>
    <string name="frutilla_cosecha">75 a 90 días</string>
    <string name="frutilla_distancia">25 cm entre plantas</string>
    <string name="frutilla_nutrientes">Potasio para que los frutos sean dulces</string>
    <string name="frutilla_plagas">Araña roja y hongo gris (botritis).</string>
    <string name="frutilla_consejo">No mojes los frutos para evitar que se pudran.</string>

    <!-- Espinaca -->
    <string name="espinaca_nombre">Espinaca</string>
    <string name="espinaca_emoji">🥗</string>
    <string name="espinaca_descripcion">Hortaliza de hoja que prefiere el clima fresco. Tiene mucho hierro.</string>
    <string name="espinaca_sistema">Raíz flotante</string>
    <string name="espinaca_luz">10 a 12 horas al día</string>
    <string name="espinaca_germinacion">7 a 14 días</string>
    <string name="espinaca_cosecha">40 a 50 días</string>
    <string name="espinaca_distancia">15 cm entre plantas</string>
    <string name="espinaca_nutrientes">Nitrógeno y hierro</string>
    <string name="espinaca_plagas">Minador de hojas y pulgones.</string>
    <string name="espinaca_consejo">Con mucho calor florece (se espiga) y las hojas se ponen amargas.</string>

    <!-- Cilantro -->
    <string name="cilantro_nombre">Cilantro</string>
    <string name="cilantro_emoji">🌱</string>
    <string name="cilantro_descripcion">Hierba de crecimiento rápido. Se usa en ensaladas, pebre y sopas.</string>
    <string name="cilantro_sistema">NFT o raíz flotante</string>
    <string name="cilantro_luz">12 a 14 horas al día</string>
    <string name="cilantro_germinacion">7 a 10 días</string>
    <string name="cilantro_cosecha">45 a 70 días</string>
    <string name="cilantro_distancia">10 cm entre plantas</string>
    <string name="cilantro_nutrientes">Nitrógeno</string>
    <string name="cilantro_plagas">Pulgones.</string>
    <string name="cilantro_consejo">Siembra un poco cada 2 o 3 semanas porque florece rápido.</string>
