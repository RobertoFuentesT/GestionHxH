<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Pantalla con scroll: espacio alrededor del contenido -->
    <style name="Contenedor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/padding_pantalla</item>
    </style>

    <!-- Botón principal de ancho completo -->
    <style name="Boton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/texto_normal</item>
    </style>

    <!-- Botón "Volver" pequeño, arriba de cada pantalla -->
    <style name="Boton.Volver" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/texto_normal</item>
    </style>

    <!-- Estilo base de los textos (los de abajo heredan de este) -->
    <style name="Texto" />

    <!-- Títulos -->
    <style name="Texto.TituloApp">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto_titulo_app</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="Texto.TituloPantalla">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margen_campo</item>
        <item name="android:textSize">@dimen/texto_titulo_pantalla</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Seccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margen_seccion</item>
        <item name="android:textSize">@dimen/texto_seccion</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Etiqueta en negrita sobre cada campo del formulario -->
    <style name="Texto.Etiqueta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margen_campo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto normal con espacio entre líneas -->
    <style name="Texto.Normal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto_normal</item>
        <item name="android:lineSpacingExtra">@dimen/espacio_lineas</item>
    </style>

    <!-- Campo de texto -->
    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>